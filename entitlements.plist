<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<!-- 系统文件选择器是独立进程，选中文件后要靠这个权限把文件访问权交回本 App；
	     缺了它，选择器里文件看着能点、点了却没有任何回调。 -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- 加载 ad-hoc 签名（只有 cdhash、没有证书链）的第三方二进制，必须显式声明，
	     否则 AMFI 在 dlopen 那一刻直接杀掉进程，且不写崩溃日志。 -->
	<key>com.apple.private.amfi.can-execute-cdhash</key>
	<true/>
	<!-- 调用 hv_* 需要的内核特权。 -->
	<key>com.apple.private.hypervisor</key>
	<true/>
	<key>com.apple.private.memorystatus</key>
	<true/>
	<key>get-task-allow</key>
	<true/>
</dict>
</plist>
